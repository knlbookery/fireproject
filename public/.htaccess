<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_dir.c>
  Options -Indexes
</IfModule>

# Deny access to dotfiles (except this one, which Apache never serves via URL anyway)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed static assets can be cached long-term; index.html must not be.
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|ico|webp)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never rewrite the PHP API — those are real files under api/.
  RewriteRule ^api/ - [L]

  # Serve real files and directories as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls back to index.html (client-side routing).
  RewriteRule ^ index.html [L]
</IfModule>
